<?xml version="1.0"?>
<ruleset name="Acme Free Shipping Nudge">
	<description>WooCommerce coding standards, which extend the WordPress Coding Standards.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WooCommerce-Core"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="acme-free-shipping-nudge"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="acme_free_shipping_nudge"/>
				<element value="Acme_Free_Shipping_Nudge"/>
			</property>
		</properties>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- PHPUnit discovers tests by class and file name, which WordPress naming rules forbid. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
