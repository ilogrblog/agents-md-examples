{
    "name": "acme/reading-time",
    "description": "Example WordPress plugin used to test an AGENTS.md file.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.4",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload-dev": {
        "classmap": ["includes/"]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit"
    }
}
